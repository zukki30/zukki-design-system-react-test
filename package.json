{
  "name": "zukki-design-system-react-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "check:props": "tsx scripts/check-props-coverage.ts",
    "ds:check": "tsx scripts/update-design-system.ts --check",
    "ds:update": "tsx scripts/update-design-system.ts",
    "verify": "pnpm ds:check && pnpm typecheck && pnpm check:props && pnpm build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zukki-design-system": "github:zukki30/zukki-design-system-react#v3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "zukki-design-system"
    ]
  }
}
